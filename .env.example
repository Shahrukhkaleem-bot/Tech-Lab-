# =============================================================================
# Environment variables. Copy to .env.local for development. NEVER commit real values.
#
#   PUBLIC (NEXT_PUBLIC_*)  → inlined into the browser bundle. Must be safe to expose.
#   SERVER-ONLY             → read only in server code (src/config/server-env.ts is
#                             `server-only`; importing it from the client fails the build).
#   CI/CD                   → GitHub Actions secrets only; not needed by the running app.
# =============================================================================

# ----------------------------------------------------------------------------- PUBLIC
# Supabase project URL + anon key (RLS protects all data; the anon key is public by design).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apex domain for tenant subdomains (no protocol). Dev: localhost:3000 → use store.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Optional; only needed if you add Stripe.js on the client (hosted Checkout does not need it).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------- SERVER-ONLY
# Bypasses RLS. Used ONLY by src/lib/supabase/service.ts (checkout, guest order lookup, webhooks).
SUPABASE_SERVICE_ROLE_KEY=
# Tenant served on hosts without a tenant (localhost:3000, *.vercel.app previews).
DEV_TENANT=demo-electronics
# Card payments (optional). Leave empty to hide the Card option.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: automate custom-domain provisioning via the Vercel API (scripts/add-domain.ts).
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# debug | info | warn | error
LOG_LEVEL=info

# ----------------------------------------------------------------------------- CI/CD (GitHub secrets)
# VERCEL_TOKEN=            Vercel deploy token
# VERCEL_ORG_ID=           from .vercel/project.json after `vercel link`
# VERCEL_PROJECT_ID=       from .vercel/project.json after `vercel link`
# SUPABASE_ACCESS_TOKEN=   personal access token for `supabase db push`
# SUPABASE_PROJECT_REF=    production project ref
# SUPABASE_DB_PASSWORD=    production database password
